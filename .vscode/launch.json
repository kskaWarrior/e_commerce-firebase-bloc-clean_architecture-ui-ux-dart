    "version": "0.2.0",
    "configurations": [
        {
            "name": "buybuy (debug)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file=brands/buybuy/brand.json"
            ]
        },
        {
            "name": "buybuy (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file=brands/buybuy/brand.json"
            ]
        },
        {
            "name": "buybuy (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=brands/buybuy/brand.json"
            ]
        }
    ]
}
